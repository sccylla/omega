{
  "version": 2,
  "functions": {
    "api/market.js": {
      "maxDuration": 15
    },
    "api/demo.js": {
      "maxDuration": 25
    },
    "api/quant.js": {
      "maxDuration": 25
    },
    "api/intelligence.js": {
      "maxDuration": 25
    },
    "api/forex-demo.js": {
      "maxDuration": 25
    },
    "api/scanner.js": {
      "maxDuration": 25
    },
    "api/live.js": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/api/demo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "regions": [
    "fra1"
  ]
}